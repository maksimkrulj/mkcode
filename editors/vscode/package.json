{
  "name": "mk-lang",
  "displayName": "MK Language",
  "description": "MK support: syntax highlighting plus a language server with live errors, hover types, go to definition and completion",
  "version": "0.2.0",
  "publisher": "maksimkrulj",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maksimkrulj/mkcode.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:mk"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "contributes": {
    "languages": [
      {
        "id": "mk",
        "aliases": ["MK", "mk"],
        "extensions": [".mk"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mk",
        "scopeName": "source.mk",
        "path": "./syntaxes/mk.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.interpolation.mk": "mk"
        }
      }
    ],
    "configuration": {
      "title": "MK",
      "properties": {
        "mk.serverPath": {
          "type": "string",
          "default": "mk",
          "description": "Command that starts the MK compiler; the extension runs '<serverPath> lsp'."
        }
      }
    }
  }
}
